<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NBomber" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reuses the server's own hashing, not a second implementation, to
         generate the device keys this project's device-fleet scenario
         needs. See ApiKeyHasher's own doc comment for why one shared
         implementation matters. -->
    <ProjectReference Include="..\..\src\Ledger.SyncServer\Ledger.SyncServer.csproj" />
  </ItemGroup>

</Project>
