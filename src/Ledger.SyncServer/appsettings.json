{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ApiKeys": {
    // SHA-256 hashes (lowercase hex) of the device API keys allowed to
    // call this server — never the keys themselves. Empty by default:
    // every request is rejected until at least one hash is configured
    // here or via an environment/user-secrets override. See README for
    // how to generate one.
    "Hashes": []
  },
  "RateLimiting": {
    // Per device (partitioned by API key hash, not IP), per window.
    // These defaults are a starting point, not a measured production
    // number — there's no real traffic yet to size them against.
    "PermitLimit": 100,
    "WindowSeconds": 60
  }
}
